# ==========================================
# VeriCapVdo AI Studio - Environment Variables
# ==========================================

# 1. Google Gemini API Key (ฟรี 100% จาก Google AI Studio: https://aistudio.google.com/app/apikey)
# [ทางเลือกที่ 1] ระบุใน Vercel Environment Variables เพื่อให้ระบบมี Key ส่วนกลางพร้อมใช้ทันที (Step 3 MV Studio เท่านั้น)
# [ทางเลือกที่ 2] ปล่อยว่างไว้ และให้ผู้ใช้งานกรอก Key ฟรีผ่านหน้าเว็บได้โดยตรง
GEMINI_API_KEY=

# 2. Google Sheets License API Web App URL (ตรวจสอบสิทธิ์ License Key ผ่าน Google Sheets)
# คัดลอก URL หลัง Deploy Web App ใน Apps Script มาใส่ที่นี่ (เฉพาะฝั่ง Server เท่านั้น ห้ามใช้ NEXT_PUBLIC_*)
LICENSE_API_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec

# 3. Secret สำหรับลงนาม HttpOnly Session Cookie (แนะนำให้ตั้งค่าแบบสุ่มยาว 32+ ตัวอักษรใน Production)
LICENSE_SESSION_SECRET=

# 4. (ไม่บังคับ) รหัสลับตรวจสอบคำขอระหว่าง Next.js Server กับ Google Apps Script (ตั้งค่าให้ตรงกับ Script Property: LICENSE_SHARED_SECRET)
LICENSE_SHARED_SECRET=
