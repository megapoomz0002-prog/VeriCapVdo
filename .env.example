# ==========================================
# VeriCapVdo AI Studio - Environment Variables
# ==========================================

# 1. Google Gemini API Key (ฟรี 100% จาก Google AI Studio: https://aistudio.google.com/app/apikey)
# [ทางเลือกที่ 1] ระบุใน Vercel Environment Variables เพื่อให้ระบบมี Key ส่วนกลางพร้อมใช้ทันที
# [ทางเลือกที่ 2] ปล่อยว่างไว้ และให้ผู้ใช้งานกรอก Key ฟรีผ่านหน้าเว็บได้โดยตรง (บันทึกในเบราว์เซอร์ปลอดภัย 100%)
GEMINI_API_KEY=

# 2. Google Sheets License API Web App URL (ตรวจสอบสิทธิ์ License Key ผ่าน Google Sheets)
# หากปล่อยว่าง ระบบจะใช้ค่าเริ่มต้นจากระบบเชื่อมต่อของโปรเจกต์
LICENSE_API_URL=https://script.google.com/macros/s/AKfycbxWiOiFblrmursQ1L9G2BDyk67JQd8Q4vUgO68kBA7mRq523YUbdwf9_V1ZgscrjquG/exec
